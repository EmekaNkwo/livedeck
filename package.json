{
  "name": "livedeck-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-based video broadcasting and live production studio. Guests join by room link; only signaling needs a server.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint src e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "coverage:all": "node scripts/coverage-all.mjs",
    "jitsi:up": "bash deploy/jitsi-local/jitsi-local.sh up",
    "jitsi:down": "bash deploy/jitsi-local/jitsi-local.sh down"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "mediabunny": "1.60.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "monocart-coverage-reports": "2.13.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
