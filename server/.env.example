# ---------------------------------------------------------------------------
# LiveDeck media server.
#
# Read from the process environment; the server does not parse a .env file
# itself. Set these in your shell or your host's config.
# ---------------------------------------------------------------------------

# HTTP + WebSocket port. The studio's default resolution expects 3001.
PORT=3001

# Interface to bind. HOST, not HOSTNAME: Windows pre-sets HOSTNAME to the
# machine name, which would stop localhost from reaching it.
HOST=0.0.0.0

# Comma-separated browser origins allowed to connect. UNSET MEANS ANY ORIGIN,
# fine on a laptop and wrong anywhere else. `scheme://host[:port]`, no path.
# ALLOWED_ORIGINS=https://studio.example.com,http://localhost:5173

# Honour X-Forwarded-For for per-address connection caps. Only behind a proxy
# you control; otherwise clients can forge it.
# TRUST_PROXY=true

# ---------------------------------------------------------------------------
# Room keys.
#
# Director and producer roles are granted by keys derived from this secret.
# Without it a random secret is generated per run and every director link
# stops working on restart. At least 16 characters; use 32+ random ones.
# ---------------------------------------------------------------------------
# ROOM_KEY_SECRET=

# ---------------------------------------------------------------------------
# mediasoup.
#
# The SFU terminates every participant's media, so the media ports must be
# reachable from the internet. One port per worker, from MEDIASOUP_PORT.
# ---------------------------------------------------------------------------
# Address clients can reach: the host's public IP or DNS name. Required for
# anything but localhost — inside a container the default (unset) advertises
# the container's own interface, which nobody outside can reach.
# MEDIASOUP_ANNOUNCED_ADDRESS=203.0.113.10

# First media port. Each worker takes port + index (UDP and TCP).
# MEDIASOUP_PORT=40000
# Workers (processes). Default: CPU count, capped at 4.
# MEDIASOUP_WORKERS=2
# MEDIASOUP_LISTEN_IP=0.0.0.0
# MEDIASOUP_ENABLE_UDP=true
# MEDIASOUP_ENABLE_TCP=true
# MEDIASOUP_LOG_LEVEL=warn
# Per-transport caps, bits per second.
# MEDIASOUP_INITIAL_OUTGOING_BITRATE=1000000
# MEDIASOUP_MAX_INCOMING_BITRATE=4000000

# ---------------------------------------------------------------------------
# TURN. Optional; without it clients behind symmetric NAT cannot reach the
# SFU and the studio says so. Credentials are minted per session, delivered
# only inside the join response, and expire after TURN_TTL_SECONDS
# (default 3600, range 600-7200). There is no public credential endpoint.
# ---------------------------------------------------------------------------
# Option A: Cloudflare Realtime TURN (dashboard -> Realtime -> TURN -> key).
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Option B: coturn (or compatible) with `use-auth-secret` / `static-auth-secret`.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_STATIC_AUTH_SECRET=
# TURN_TTL_SECONDS=3600
