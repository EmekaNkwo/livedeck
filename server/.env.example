# ---------------------------------------------------------------------------
# LiveDeck media server.
#
# Read from the process environment; the server does not parse a .env file
# itself. Set these in your shell or your host's config.
# ---------------------------------------------------------------------------

# HTTP + WebSocket port. The studio's default resolution expects 3001.
PORT=3001

# Interface to bind. HOST, not HOSTNAME: Windows pre-sets HOSTNAME to the
# machine name, which would stop localhost from reaching it.
HOST=0.0.0.0

# Comma-separated browser origins allowed to connect. UNSET MEANS ANY ORIGIN,
# fine on a laptop and wrong anywhere else. `scheme://host[:port]`, no path.
# ALLOWED_ORIGINS=https://studio.example.com,http://localhost:5173

# Participants per room, every connection counted (director, producers,
# guests, viewers). Default 16, enough for a twelve-guest studio plus crew.
# ROOM_MAX_PEERS=16
# MAX_ROOMS=200

# Honour X-Forwarded-For for per-address connection caps. Only behind a proxy
# you control; otherwise clients can forge it.
# TRUST_PROXY=true

# ---------------------------------------------------------------------------
# Room keys.
#
# Director and producer roles are granted by keys derived from this secret.
# Without it a random secret is generated per run and every director link
# stops working on restart. At least 16 characters; use 32+ random ones.
# ---------------------------------------------------------------------------
# ROOM_KEY_SECRET=

# ---------------------------------------------------------------------------
# Media: Jitsi. Audio and video travel through Jitsi; this server signs each
# participant a token for their room's conference, valid for up to an hour,
# naming them and making only the director a moderator. Without one of the
# two backends below, joins are refused.
# ---------------------------------------------------------------------------
# Option A (production): JaaS by 8x8. In the JaaS console: copy the AppID,
# add an API key and download its private key.
# JAAS_APP_ID=vpaas-magic-cookie-0123456789abcdef0123456789abcdef
# The key's id as the console shows it: "<AppID>/<key id>".
# JAAS_API_KEY_ID=vpaas-magic-cookie-0123456789abcdef0123456789abcdef/a1b2c3
# The private key PEM. On hosts with single-line variables, replace the
# newlines with literal \n.
# JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JAAS_USE_STAGING=false

# Option B: a self-hosted Jitsi with JWT auth (docker-jitsi-meet AUTH_TYPE=jwt).
# Used by the test setup in deploy/jitsi-local/.
# JITSI_PUBLIC_URL=https://localhost:8443
# JITSI_DOMAIN=meet.jitsi
# JITSI_APP_ID=livedeck
# JITSI_APP_SECRET=
# JITSI_MUC_DOMAIN=muc.meet.jitsi
# JITSI_AUDIENCE=jitsi

# Token lifetime in seconds, 600-3600. Clients renew before expiry.
# MEDIA_GRANT_TTL_SECONDS=3600
