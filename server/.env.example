# ---------------------------------------------------------------------------
# Signaling relay.
#
# Copy to `server/.env`. These are read from the process environment, so set
# them in your shell or your host's config — the Node server does not parse a
# .env file itself, and a `.env` at the repository root is read by Vite only.
# ---------------------------------------------------------------------------

# HTTP and WebSocket port. The studio's default resolution expects 3001.
PORT=3001

# Interface to bind. Deliberately HOST, not HOSTNAME — Windows pre-sets
# HOSTNAME to the machine name, which would stop localhost from reaching it.
HOST=0.0.0.0

# Comma-separated origins allowed to connect. UNSET MEANS ANY ORIGIN, which is
# fine on a laptop and wrong anywhere else — the server warns about it on
# startup. Set it before exposing the relay publicly.
#
# An origin is `scheme://host[:port]` and nothing else. NO TRAILING SLASH, no
# path: a value copied out of a browser address bar carries one, and that
# refuses every real browser while a `curl` probe using the same trailing slash
# passes — pointing the diagnosis in exactly the wrong direction. The server
# normalizes trailing slashes, whitespace and case for you now, and logs the
# effective list on startup, so check that log if a browser cannot connect.
#
# The scheme does matter: `http://studio.example.com` will not match a studio
# served over https. Include every origin that needs in, localhost included.
# ALLOWED_ORIGINS=https://studio.example.com,http://localhost:5173
