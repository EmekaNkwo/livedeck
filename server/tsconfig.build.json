{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    /*
     * The repository root, not `src`: the server imports `../../shared/*`,
     * which is compiled into both the browser and this process so the two
     * cannot drift. The output mirrors the repository:
     *
     *   dist/server/src/server.js
     *   dist/shared/protocol.js
     */
    "rootDir": "..",
    "incremental": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src", "../shared"],
  "exclude": ["src/**/*.test.ts", "../shared/**/*.test.ts"]
}
