# Copy to deploy/.env and fill in. Read by docker compose (--env-file).

# Public DNS name pointing at this host. `localhost` for a local trial
# (Caddy then issues a certificate from its own local CA).
LIVEDECK_DOMAIN=studio.example.com

# The address browsers reach this host on, for media and TURN. A public IPv4
# on a server; 127.0.0.1 for a local trial.
PUBLIC_IP=203.0.113.10

# Generate each with: openssl rand -base64 48
ROOM_KEY_SECRET=
TURN_STATIC_AUTH_SECRET=

# Only when the studio is served on non-standard ports (local trials):
# HTTP_PORT=8080
# HTTPS_PORT=8443
# PUBLIC_ORIGIN=https://localhost:8443
